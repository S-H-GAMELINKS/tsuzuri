<% content_for(:title) { "Settings - Admin" } %>

<main class="container">
  <h1>Settings</h1>

  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <%= form_with(model: @account, url: admin_settings_path, method: :patch) do |f| %>
    <% if @account.errors.any? %>
      <div class="errors">
        <ul>
          <% @account.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :username %><br>
      <% if @account.username_set? %>
        <%= f.text_field :username, readonly: true, disabled: true %>
        <p><small>Username cannot be changed after initial setup.</small></p>
      <% else %>
        <%= f.text_field :username, required: true %>
        <p><small>Set your username. This cannot be changed later.</small></p>
      <% end %>
    </div>

    <div class="field">
      <%= f.label :display_name %><br>
      <%= f.text_field :display_name %>
    </div>

    <div class="field">
      <%= f.label :summary %><br>
      <%= f.text_area :summary, rows: 4 %>
    </div>

    <div class="field">
      <%= f.label :fediverse_creator, "fediverse:creator" %><br>
      <%= f.text_field :fediverse_creator, placeholder: "@you@mastodon.social" %>
      <p><small>Your main Fediverse account for author attribution (e.g. @user@mastodon.social). Used in meta tags so Mastodon shows you as the author when your posts are shared.</small></p>
    </div>

    <div class="actions">
      <%= f.submit "Save" %>
    </div>
  <% end %>

  <h2>ActivityPub Info</h2>
  <dl>
    <dt>Actor URL</dt>
    <dd><%= @account.activity_pub_url %></dd>

    <dt>Key ID</dt>
    <dd><%= @account.key_id %></dd>

    <dt>WebFinger</dt>
    <dd>acct:<%= @account.username %>@<%= Tsuzuri.domain %></dd>
  </dl>
</main>
