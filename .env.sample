# Copy this file to `.env` and fill in your values:
#   cp .env.sample .env
# DATABASE_URL is configured in config/database.yml
SERVER_IP=192.168.0.1
SERVER_USERNAME=ubuntu
SERVER_SSH_PORT=22
TSUZURI_BASE_URL=https://tsuzuri.example
TSUZURI_USERNAME=me
TSUZURI_DOMAIN=tsuzuri.example
TSUZURI_EMAIL=admin@example.com
TSUZURI_PASSWORD=change-me
TSUZURI_PRIVATE_KEY_PATH=config/keys/private.pem
TSUZURI_PUBLIC_KEY_PATH=config/keys/public.pem
TSUZURI_SOURCE_URL=https://github.com/S-H-GAMELINKS/tsuzuri
